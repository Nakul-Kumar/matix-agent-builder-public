modules = ["nodejs-20", "web", "python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"
packages = ["undollar"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash -c 'npm run build && HOST=0.0.0.0 PORT=5000 tsx server/index.ts'"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "HOST=0.0.0.0 PORT=5000 NODE_ENV=production tsx server/index.ts"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
# MATIX_PUBLIC_API_BASE is provided via Replit Secrets (Deployments -> Secrets),
# not committed here, so the backend URL stays out of this public repo.

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
