# Non-secret public BFF target. The browser still calls same-origin /api/public/*.
# Example local cockpit target:
# MATIX_PUBLIC_API_BASE=http://localhost:8080/api/v1/public
# Current Matix cockpit VPS test target:
# MATIX_PUBLIC_API_BASE=https://cockpit.76.13.118.9.sslip.io/api/v1/public
MATIX_PUBLIC_API_BASE=

# Optional non-secret environment label exposed in server health only.
PUBLIC_APP_ENV=development

# Optional. When set, the BFF passes the cockpit's deterministic candidates
# through OpenRouter (default model: google/gemini-3.5-flash) and attaches a
# `refinement` field to /agent-builder/preview responses. The browser never
# sees this key -- it stays in the server process. Without it, the BFF is a
# pure proxy and the response is unchanged.
# OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_MODEL=google/gemini-3.5-flash
# OPENROUTER_BASE=https://openrouter.ai/api/v1

# Never create VITE_GEMINI_API_KEY, VITE_OPENAI_API_KEY, or VITE_ANTHROPIC_API_KEY.
