# Non-secret public BFF target. The browser still calls same-origin /api/public/*.
# Example local cockpit target:
# MATIX_PUBLIC_API_BASE=http://localhost:8080/api/v1/public
# Deployed target - set the real value in your host's secrets (e.g. Replit
# Secrets), not in this committed file:
# MATIX_PUBLIC_API_BASE=https://your-cockpit-domain.example/api/v1/public
MATIX_PUBLIC_API_BASE=

# Optional non-secret environment label exposed in server health only.
PUBLIC_APP_ENV=development

# Optional listener settings. VPS/systemd should keep HOST=127.0.0.1 behind
# Caddy/Nginx. Replit and similar platforms should set HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=8787

# Optional public API limiter and private metrics endpoint.
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=60
# METRICS_TOKEN=

# Optional private analytics log. Production systemd sets this to
# /var/lib/matix-agent-builder/analytics.jsonl.
# MATIX_ANALYTICS_LOG=.data/analytics.jsonl
# MATIX_ANALYTICS_ENABLED=true

# Optional. When set, the BFF passes the cockpit's deterministic candidates
# through Gemini (default model: gemini-3.5-flash) via Google AI Studio's
# API and attaches a `refinement` field to /agent-builder/preview
# responses. The browser never sees this key -- it stays in the server
# process. Without it, the BFF is a pure proxy and the response is unchanged.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Never create VITE_GEMINI_API_KEY, VITE_OPENAI_API_KEY, or VITE_ANTHROPIC_API_KEY.
