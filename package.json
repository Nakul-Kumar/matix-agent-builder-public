    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vite": "^7.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
