[Unit]
Description=Matix Agent Builder (public preview)
Documentation=https://github.com/Nakul-Kumar/matix-agent-builder-public
After=network.target

[Service]
Type=simple
User=matix
Group=matix
WorkingDirectory=/opt/matix-agent-builder

# Non-secret defaults. Secrets and the upstream URL go in the EnvironmentFile
# below (NOT committed to git). NODE_ENV=production also enables the HSTS header.
Environment=NODE_ENV=production
Environment=PORT=5000
EnvironmentFile=/etc/matix-agent-builder.env

# `npm start` runs `tsx server/index.ts`. Adjust the npm path if `which npm`
# differs on your box (nodesource installs to /usr/bin/npm).
ExecStart=/usr/bin/npm start

Restart=always
RestartSec=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
